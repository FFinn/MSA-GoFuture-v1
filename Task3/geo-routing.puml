@startuml GoFuture_Geo_Routing_Task3
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_LEFT_RIGHT()
title GoFuture — географическая маршрутизация пользовательского трафика

AddElementTag("task3", $bgColor="#FDECEC", $fontColor="#B71C1C", $borderColor="#D32F2F")
AddRelTag("task3", $textColor="#D32F2F", $lineColor="#D32F2F")

Person(sea_user, "Пользователь в Юго-Восточной Азии", "Пассажир или водитель", $tags="task3")
Person(sa_user, "Пользователь в Южной Америке", "Пассажир или водитель", $tags="task3")

System_Boundary(global_edge, "Глобальный пограничный контур") {
    Container(dns, "Единое имя GoFuture", "Cloud DNS", "Разрешает имя глобального входа", $tags="task3")
    Container(waf, "Политика Cloud Armor", "WAF", "Применяется на глобальном балансировщике", $tags="task3")
    Container(lb, "Глобальный внешний балансировщик приложений", "Google Cloud Load Balancing", "Для новой операции выбирает ближайший здоровый регион", $tags="task3")
    Container(health, "Региональные проверки состояния", "Health Checks", "Контролируют доступность критического пути региона", $tags="task3")
    ContainerDb(owner_registry, "Реестр активного владельца сегмента", "Cloud Spanner", "home_region → active_region, epoch и состояние", $tags="task3")
}

System_Boundary(sea, "Юго-Восточная Азия") {
    Container(sg, "Сингапур", "региональный GKE, asia-southeast1", "Внутренний идентификатор: sg", $tags="task3")
    Container(sg_gateway, "Шлюз программного интерфейса — Сингапур", "HTTP/REST", "Определяет сегмент сущности и текущего владельца", $tags="task3")
    Container(jkt, "Джакарта", "региональный GKE, asia-southeast2", "Внутренний идентификатор: jkt", $tags="task3")
    Container(jkt_gateway, "Шлюз программного интерфейса — Джакарта", "HTTP/REST", "Определяет сегмент сущности и текущего владельца", $tags="task3")
}

System_Boundary(sa, "Южная Америка") {
    Container(sao, "Сан-Паулу", "региональный GKE, southamerica-east1", "Внутренний идентификатор: sao", $tags="task3")
    Container(sao_gateway, "Шлюз программного интерфейса — Сан-Паулу", "HTTP/REST", "Определяет сегмент сущности и текущего владельца", $tags="task3")
    Container(scl, "Сантьяго", "региональный GKE, southamerica-west1", "Внутренний идентификатор: scl", $tags="task3")
    Container(scl_gateway, "Шлюз программного интерфейса — Сантьяго", "HTTP/REST", "Определяет сегмент сущности и текущего владельца", $tags="task3")
}

Rel(sea_user, dns, "Обращается к единому имени", "DNS", $tags="task3")
Rel(sa_user, dns, "Обращается к единому имени", "DNS", $tags="task3")
Rel(dns, lb, "Возвращает глобальный адрес", $tags="task3")
Rel(waf, lb, "Применяет политику защиты", $tags="task3")
Rel(health, lb, "Передаёт состояние регионов", $tags="task3")

Rel(lb, sg, "Новая операция: ближайший здоровый регион", $tags="task3")
Rel(lb, jkt, "Новая операция: ближайший здоровый регион", $tags="task3")
Rel(lb, sao, "Новая операция: ближайший здоровый регион", $tags="task3")
Rel(lb, scl, "Новая операция: ближайший здоровый регион", $tags="task3")

Rel(sg, sg_gateway, "Передаёт запрос", $tags="task3")
Rel(jkt, jkt_gateway, "Передаёт запрос", $tags="task3")
Rel(sao, sao_gateway, "Передаёт запрос", $tags="task3")
Rel(scl, scl_gateway, "Передаёт запрос", $tags="task3")

Rel(sg_gateway, owner_registry, "Для существующей сущности читает active_region", $tags="task3")
Rel(jkt_gateway, owner_registry, "Для существующей сущности читает active_region", $tags="task3")
Rel(sao_gateway, owner_registry, "Для существующей сущности читает active_region", $tags="task3")
Rel(scl_gateway, owner_registry, "Для существующей сущности читает active_region", $tags="task3")

Rel(health, sg_gateway, "Проверяет готовность", $tags="task3")
Rel(health, jkt_gateway, "Проверяет готовность", $tags="task3")
Rel(health, sao_gateway, "Проверяет готовность", $tags="task3")
Rel(health, scl_gateway, "Проверяет готовность", $tags="task3")

Rel(sg_gateway, jkt_gateway, "Передаёт запрос сегмента, если active_region=jkt", $tags="task3")
Rel(jkt_gateway, sg_gateway, "Передаёт запрос сегмента, если active_region=sg", $tags="task3")
Rel(sao_gateway, scl_gateway, "Передаёт запрос сегмента, если active_region=scl", $tags="task3")
Rel(scl_gateway, sao_gateway, "Передаёт запрос сегмента, если active_region=sao", $tags="task3")

note right of lb #FDECEC
  Ближайший регион выбирается только для новой операции.
  После создания сущность получает home_region.
  Для существующей поездки шлюз использует active_region
  из реестра владения, а не повторный выбор по расстоянию.
end note

note bottom of sea #FDECEC
  Штатно: sg обслуживает сегменты sg, jkt — сегменты jkt.
  После аварии Сингапура реестр меняется на sg -> jkt
  только после повышения резервных баз и проверки готовности.
end note

note bottom of sa #FDECEC
  Для Сан-Паулу и Сантьяго применяется тот же принцип:
  sao <-> scl с сохранением home_region бизнес-сущности.
end note

SHOW_LEGEND()
@enduml