@startuml GoFuture_C2_Global_Deployment_Task3
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_LEFT_RIGHT()

title GoFuture — C2 глобального развёртывания и защиты

AddElementTag("task3", $bgColor="#FDECEC", $fontColor="#B71C1C", $borderColor="#D32F2F")
AddRelTag("task3", $textColor="#D32F2F", $lineColor="#D32F2F")

Person(passenger, "Пассажир", "Использует мобильное приложение")
Person(driver, "Водитель", "Работает с поездками и передаёт координаты")
Person(sre, "SRE-инженер", "Контролирует доступность и аварийные переключения")

System_Boundary(gofuture, "GoFuture") {
    Container(passenger_app, "Пассажирское приложение", "iOS / Android / Huawei", "Клиент пассажира")
    Container(driver_app, "Водительское приложение", "iOS / Android / Huawei", "Клиент водителя")

    Boundary(global_edge, "Глобальный вход — изменения Task3") {
        Container(global_dns, "Глобальная DNS-зона", "Cloud DNS", "Единое публичное имя GoFuture", $tags="task3")
        Container(global_lb, "Глобальный внешний балансировщик приложений", "Google Cloud Load Balancing", "Выбирает ближайший здоровый регион с допустимым размещением данных", $tags="task3")
        Container(waf, "Политика защиты веб-приложений", "Cloud Armor", "WAF, защита от DDoS и ограничение частоты запросов", $tags="task3")
    }

    Boundary(regional_entry, "Региональные точки входа — изменения Task3") {
        Container(sg_entry, "Сингапур", "региональный GKE, asia-southeast1", "Регион sg; кластер в нескольких зонах", $tags="task3")
        Container(jkt_entry, "Джакарта", "региональный GKE, asia-southeast2", "Регион jkt; кластер в нескольких зонах", $tags="task3")
        Container(sao_entry, "Сан-Паулу", "региональный GKE, southamerica-east1", "Регион sao; кластер в нескольких зонах", $tags="task3")
        Container(scl_entry, "Сантьяго", "региональный GKE, southamerica-west1", "Регион scl; кластер в нескольких зонах", $tags="task3")
    }

    Container(api_gateway, "Шлюз программного интерфейса", "HTTP/REST", "Региональная входная точка клиентских запросов; логически тот же компонент, что в Task1 и Task2")

    Boundary(domains, "Доменные сервисы — сохраняются из Task1 и Task2") {
        Container(booking, "Booking — сервис бронирования", "Django / Python", "Жизненный цикл поездки; оркестратор Saga")
        Container(driver_service, "Driver — сервис водителей", "Django / Python", "Профиль, доступность и резервирование водителя")
        Container(geography, "Geography — сервис географии", "Django / Python", "Геопоиск, зоны, поиск кандидатов и перераспределение водителей")
        Container(pricing, "Pricing — сервис ценообразования", "Django / Python", "Тарифы и динамическое ценообразование")
        Container(payments, "Payments — сервис платежей", "Django / Python", "Авторизация, списания, возвраты и выплаты")
        Container(fraud, "Fraud — сервис защиты от мошенничества", "Django / Python", "Оценка риска поездки и платежа")
        Container(notification, "Notification — сервис уведомлений", "Django / Python", "Отправка уведомлений")
        Container(analytics, "Analytics — сервис аналитики", "Python", "Построение аналитических проекций")

        ContainerDb(booking_db, "Booking PostgreSQL", "PostgreSQL", "Отдельная база домена Booking; бизнес-данные, outbox и inbox")
        ContainerDb(driver_db, "Driver PostgreSQL", "PostgreSQL", "Отдельная база домена Driver; бизнес-данные, outbox и inbox")
        ContainerDb(geography_db, "Geography PostgreSQL", "PostgreSQL", "Отдельная база домена Geography; бизнес-данные, outbox и inbox")
        ContainerDb(pricing_db, "Pricing PostgreSQL", "PostgreSQL", "Отдельная база домена Pricing; бизнес-данные, outbox и inbox")
        ContainerDb(payments_db, "Payments PostgreSQL", "PostgreSQL", "Отдельная база домена Payments; бизнес-данные, outbox и inbox")
        ContainerDb(fraud_db, "Fraud PostgreSQL", "PostgreSQL", "Отдельная база домена Fraud; бизнес-данные, outbox и inbox")
        ContainerDb(notification_db, "Notification PostgreSQL", "PostgreSQL", "Отдельная база домена Notification; бизнес-данные, outbox и inbox")
        ContainerDb(clickhouse, "Аналитическое хранилище", "ClickHouse", "Долговременные факты и агрегаты")

        ContainerDb(driver_cache, "Оперативное хранилище Driver", "Redis", "Только состояние и кэш домена Driver")
        ContainerDb(pricing_cache, "Оперативное хранилище Pricing", "Redis", "Только кэш правил и коэффициентов Pricing")
        ContainerDb(geography_cache, "Оперативное хранилище Geography", "Redis", "Только краткоживущее состояние Geography")
        Container(search, "Геопоисковый индекс Geography", "Elasticsearch", "Поиск водителей и географических объектов")
    }

    Boundary(event_platform, "Событийная платформа — сохраняется из Task2") {
        ContainerQueue(kafka, "Apache Kafka", "Распределённый журнал событий", "Отдельный набор топиков для каждого внутреннего региона: sg, jkt, sao, scl")
        Container(schema_registry, "Реестр схем", "Schema Registry", "Версии и проверка совместимости схем событий")
        Container(connect, "Kafka Connect + Debezium", "Захват изменений данных", "Читает outbox доменных PostgreSQL и публикует события и команды в Kafka")
        Container(flink, "Apache Flink", "Потоковая обработка", "Спрос и предложение, сигналы для цены, перераспределения водителей и Fraud")
        ContainerDb(flink_checkpoints, "Контрольные точки Flink", "Объектное хранилище", "Состояние потоковых заданий для восстановления")
    }

    Boundary(security, "Региональная защита — изменения Task3") {
        Container(vpc_fw, "Сетевой межсетевой экран VPC", "VPC Firewall", "Разрешает вход в регион только от глобального балансировщика и систем проверки состояния", $tags="task3")
        Container(net_policy, "Сетевые политики контейнеров", "Kubernetes NetworkPolicy", "Ограничивают межсервисные соединения внутри GKE", $tags="task3")
        Container(nat, "Контролируемый исходящий доступ", "Cloud NAT", "Единый контролируемый выход к внешним системам", $tags="task3")
        Container(secret_manager, "Хранилище секретов", "Secret Manager", "Пароли, сертификаты и ключи внешних интеграций", $tags="task3")
        Container(kms, "Управление ключами шифрования", "Cloud KMS", "Раздельные ключи по регионам и юрисдикциям", $tags="task3")
    }

    Boundary(replication, "Межрегиональная репликация — изменения Task3") {
        Container(db_replication, "Резервные доменные PostgreSQL", "Cloud SQL cross-region replicas", "Отдельная межрегиональная реплика для каждой доменной базы; один владелец записи", $tags="task3")
        Container(kafka_mirror, "Зеркалирование критичных событий", "Kafka MirrorMaker 2", "Выборочно зеркалирует критичные доменные топики между парными регионами", $tags="task3")
    }

    Boundary(observability, "Наблюдаемость — сохраняется из Task2") {
        Container(prometheus, "Prometheus", "Метрики", "Метрики сервисов, Kafka, Flink, баз и репликации")
        Container(grafana, "Grafana", "Визуализация", "Панели глобального и регионального состояния")
        Container(alertmanager, "Alertmanager", "Оповещения", "Маршрутизация критических оповещений")
        Container(loki, "Loki", "Журналы", "Централизованные журналы сервисов и платформы")
        Container(otel, "OpenTelemetry Collector", "Трассировка", "Собирает распределённые трассы")
        Container(jaeger, "Jaeger", "Трассировка", "Хранение и просмотр трасс по trace_id / saga_id")
        Container(kafka_exporter, "Kafka Exporter + JMX Exporter", "Экспорт метрик", "Метрики брокеров, партиций и групп потребителей")
        Container(postgres_exporter, "PostgreSQL Exporter", "Экспорт метрик", "Метрики отдельных доменных PostgreSQL и репликации")
    }
}

System_Ext(payment_gateways, "Платёжные шлюзы", "Яндекс Пэй и региональные поставщики")
