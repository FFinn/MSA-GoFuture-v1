@startuml GoFuture_C2_Global_Deployment_Task3
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_LEFT_RIGHT()
title GoFuture — C2 глобального развёртывания и защиты

AddElementTag("task3", $bgColor="#FDECEC", $fontColor="#B71C1C", $borderColor="#D32F2F")
AddRelTag("task3", $textColor="#D32F2F", $lineColor="#D32F2F")

Person(passenger, "Пассажир", "Использует мобильное приложение")
Person(driver, "Водитель", "Работает с поездками и передаёт координаты")
Person(sre, "SRE-инженер", "Контролирует состояние платформы")

System_Boundary(gofuture, "GoFuture") {
  Container(passenger_app, "Пассажирское приложение", "iOS / Android / Huawei", "Клиент пассажира")
  Container(driver_app, "Водительское приложение", "iOS / Android / Huawei", "Клиент водителя")

  Boundary(edge, "Глобальный вход — изменения задания 3") {
    Container(dns, "Глобальная DNS-зона", "Cloud DNS", "Единое публичное имя", $tags="task3")
    Container(lb, "Глобальный внешний балансировщик", "Google Cloud Load Balancing", "Для новых операций выбирает ближайший здоровый регион", $tags="task3")
    Container(armor, "Политика защиты веб-приложений", "Cloud Armor", "Правила WAF и ограничение частоты запросов", $tags="task3")
    ContainerDb(owner_registry, "Реестр активного владельца сегмента", "Cloud Spanner", "home_region, active_region, epoch, состояние и аренда права записи", $tags="task3")
  }

  Boundary(regions, "Региональные контуры — изменения задания 3") {
    Container(sg, "Сингапур", "региональный GKE, asia-southeast1", "Регион sg", $tags="task3")
    Container(jkt, "Джакарта", "региональный GKE, asia-southeast2", "Регион jkt", $tags="task3")
    Container(sao, "Сан-Паулу", "региональный GKE, southamerica-east1", "Регион sao", $tags="task3")
    Container(scl, "Сантьяго", "региональный GKE, southamerica-west1", "Регион scl", $tags="task3")
  }

  Container(api_gateway, "Шлюз программного интерфейса", "HTTP/REST", "Региональный экземпляр; определяет домашний сегмент и текущий активный регион")

  Boundary(domains, "Доменные сервисы") {
    Container(booking, "Booking — сервис бронирования", "Django / Python", "Жизненный цикл поездки; оркестратор Saga")
    Container(driver_service, "Driver — сервис водителей", "Django / Python", "Доступность и резервирование водителя")
    Container(geography, "Geography — сервис географии", "Django / Python", "Геопоиск и подбор водителя")
    Container(pricing, "Pricing — сервис ценообразования", "Django / Python", "Тарифы и динамическая цена")
    Container(payments, "Payments — сервис платежей", "Django / Python", "Платежи, возвраты и выплаты")
    Container(fraud, "Fraud — сервис защиты от мошенничества", "Django / Python", "Оценка риска")
    Container(notification, "Notification — сервис уведомлений", "Django / Python", "Уведомления")
    Container(analytics, "Analytics — сервис аналитики", "Python", "Аналитические проекции")
  }

  Boundary(data, "Доменные хранилища") {
    ContainerDb(booking_db, "Booking PostgreSQL", "PostgreSQL", "Отдельная база Booking")
    ContainerDb(driver_db, "Driver PostgreSQL", "PostgreSQL", "Отдельная база Driver")
    ContainerDb(geography_db, "Geography PostgreSQL", "PostgreSQL", "Отдельная база Geography")
    ContainerDb(pricing_db, "Pricing PostgreSQL", "PostgreSQL", "Отдельная база Pricing")
    ContainerDb(payments_db, "Payments PostgreSQL", "PostgreSQL", "Отдельная база Payments")
    ContainerDb(fraud_db, "Fraud PostgreSQL", "PostgreSQL", "Отдельная база Fraud")
    ContainerDb(notification_db, "Notification PostgreSQL", "PostgreSQL", "Отдельная база Notification")
    ContainerDb(clickhouse, "Аналитическое хранилище", "ClickHouse", "Факты и агрегаты")
    ContainerDb(driver_cache, "Оперативное хранилище Driver", "Redis", "Данные только домена Driver")
    ContainerDb(pricing_cache, "Оперативное хранилище Pricing", "Redis", "Данные только домена Pricing")
    ContainerDb(geography_cache, "Оперативное хранилище Geography", "Redis", "Данные только домена Geography")
    Container(search, "Геопоисковый индекс Geography", "Elasticsearch", "Индекс Geography")
  }

  Boundary(events, "Событийная платформа") {
    ContainerQueue(kafka, "Apache Kafka", "Распределённый журнал событий", "Отдельный набор топиков для sg, jkt, sao и scl")
    Container(schema_registry, "Реестр схем", "Schema Registry", "Версии схем событий")
    Container(connect, "Kafka Connect + Debezium", "Захват изменений данных", "Публикует записи outbox в Kafka")
    Container(flink, "Apache Flink", "Потоковая обработка", "Расчёты над потоками событий")
    ContainerDb(flink_cp, "Контрольные точки Flink", "Объектное хранилище", "Состояние заданий Flink")
  }

  Boundary(protection, "Региональная защита — изменения задания 3") {
    Container(vpc_fw, "Сетевой межсетевой экран VPC", "VPC Firewall", "Ограничивает входящий и исходящий сетевой доступ", $tags="task3")
    Container(net_policy, "Сетевые политики контейнеров", "Kubernetes NetworkPolicy", "Ограничивают межсервисные соединения", $tags="task3")
    Container(nat, "Исходящий доступ приватных узлов", "Cloud NAT", "Даёт предсказуемые внешние адреса", $tags="task3")
    Container(secret_manager, "Хранилище секретов", "Secret Manager", "Секреты внешних интеграций", $tags="task3")
    Container(kms, "Управление ключами", "Cloud KMS", "Региональные ключи шифрования", $tags="task3")
  }

  Boundary(replication, "Межрегиональная репликация — изменения задания 3") {
    Container(db_replica, "Резервные доменные базы PostgreSQL", "Cloud SQL cross-region replicas", "Отдельная резервная реплика каждой доменной базы", $tags="task3")
    Container(kafka_mirror, "Зеркалирование критичных событий", "Kafka MirrorMaker 2", "Критичные топики и контрольные точки групп потребителей", $tags="task3")
  }

  Boundary(obs, "Наблюдаемость") {
    Container(prometheus, "Prometheus", "Метрики", "Собирает метрики")
    Container(grafana, "Grafana", "Визуализация", "Панели состояния")
    Container(alertmanager, "Alertmanager", "Оповещения", "Оповещения SRE-команде")
    Container(loki, "Loki", "Журналы", "Централизованные журналы")
    Container(otel, "OpenTelemetry Collector", "Трассировка", "Собирает трассы")
    Container(jaeger, "Jaeger", "Трассировка", "Хранит трассы")
  }
}

System_Ext(payment_gateways, "Платёжные шлюзы", "Региональные поставщики")
System_Ext(bank_api, "Банковские программные интерфейсы", "Выплаты водителям")
System_Ext(maps, "Картографические сервисы", "Региональные поставщики")
System_Ext(push, "Поставщики мобильных уведомлений", "FCM / APNS / Huawei Push Kit")

Rel(passenger, passenger_app, "Использует")
Rel(driver, driver_app, "Использует")
Rel(passenger_app, dns, "Обращается к единому имени", "DNS", $tags="task3")
Rel(driver_app, dns, "Обращается к единому имени", "DNS", $tags="task3")
Rel(dns, lb, "Возвращает глобальный адрес", $tags="task3")
Rel(armor, lb, "Применяет политику защиты", $tags="task3")
Rel(lb, sg, "Новая операция: ближайший здоровый регион", $tags="task3")
Rel(lb, jkt, "Новая операция: ближайший здоровый регион", $tags="task3")
Rel(lb, sao, "Новая операция: ближайший здоровый регион", $tags="task3")
Rel(lb, scl, "Новая операция: ближайший здоровый регион", $tags="task3")
Rel(sg, api_gateway, "Передаёт запрос региональному шлюзу", $tags="task3")
Rel(jkt, api_gateway, "Передаёт запрос региональному шлюзу", $tags="task3")
Rel(sao, api_gateway, "Передаёт запрос региональному шлюзу", $tags="task3")
Rel(scl, api_gateway, "Передаёт запрос региональному шлюзу", $tags="task3")
Rel(api_gateway, owner_registry, "Определяет active_region и epoch для существующей сущности", $tags="task3")

Rel(api_gateway, booking, "Команды поездки")
Rel(api_gateway, driver_service, "Состояние водителя")
Rel(api_gateway, geography, "Обновление местоположения")
Rel(booking, owner_registry, "Проверяет право записи сегмента", $tags="task3")
Rel(payments, owner_registry, "Проверяет право записи сегмента", $tags="task3")

Rel(booking, booking_db, "Читает и записывает")
Rel(driver_service, driver_db, "Читает и записывает")
Rel(geography, geography_db, "Читает и записывает")
Rel(pricing, pricing_db, "Читает и записывает")
Rel(payments, payments_db, "Читает и записывает")
Rel(fraud, fraud_db, "Читает и записывает")
Rel(notification, notification_db, "Читает и записывает")
Rel(analytics, clickhouse, "Записывает факты и агрегаты")
Rel(driver_service, driver_cache, "Хранит состояние Driver")
Rel(pricing, pricing_cache, "Кэширует Pricing")
Rel(geography, geography_cache, "Хранит состояние Geography")
Rel(geography, search, "Использует геопоиск")

Rel(connect, booking_db, "Читает outbox")
Rel(connect, driver_db, "Читает outbox")
Rel(connect, geography_db, "Читает outbox")
Rel(connect, pricing_db, "Читает outbox")
Rel(connect, payments_db, "Читает outbox")
Rel(connect, fraud_db, "Читает outbox")
Rel(connect, notification_db, "Читает outbox")
Rel(connect, schema_registry, "Использует схемы")
Rel(connect, kafka, "Публикует события и команды")
Rel(kafka, flink, "Передаёт потоки")
Rel(flink, kafka, "Публикует сигналы")
Rel(flink, flink_cp, "Сохраняет контрольные точки")
Rel(kafka, booking, "События и результаты Saga")
Rel(kafka, driver_service, "Команды Driver")
Rel(kafka, geography, "Команды Geography")
Rel(kafka, pricing, "Команды Pricing")
Rel(kafka, payments, "Команды Payments")
Rel(kafka, fraud, "Команды Fraud")
Rel(kafka, notification, "События Notification")
Rel(kafka, analytics, "Доменные события")

Rel(vpc_fw, sg, "Ограничивает сетевой доступ", $tags="task3")
Rel(vpc_fw, jkt, "Ограничивает сетевой доступ", $tags="task3")
Rel(vpc_fw, sao, "Ограничивает сетевой доступ", $tags="task3")
Rel(vpc_fw, scl, "Ограничивает сетевой доступ", $tags="task3")
Rel(net_policy, booking, "Ограничивает межсервисные соединения", $tags="task3")
Rel(net_policy, payments, "Ограничивает межсервисные соединения", $tags="task3")
Rel(booking, secret_manager, "Получает секреты", $tags="task3")
Rel(payments, secret_manager, "Получает секреты", $tags="task3")
Rel(booking, kms, "Использует ключи шифрования", $tags="task3")
Rel(payments, kms, "Использует ключи шифрования", $tags="task3")
Rel(payments, nat, "Исходящее соединение", $tags="task3")
Rel(geography, nat, "Исходящее соединение", $tags="task3")
Rel(notification, nat, "Исходящее соединение", $tags="task3")
Rel(nat, payment_gateways, "Платежи", $tags="task3")
Rel(nat, bank_api, "Выплаты", $tags="task3")
Rel(nat, maps, "Карты", $tags="task3")
Rel(nat, push, "Уведомления", $tags="task3")

Rel(booking_db, db_replica, "Реплицируется в парный регион", $tags="task3")
Rel(driver_db, db_replica, "Реплицируется в парный регион", $tags="task3")
Rel(geography_db, db_replica, "Реплицируется в парный регион", $tags="task3")
Rel(pricing_db, db_replica, "Реплицируется в парный регион", $tags="task3")
Rel(payments_db, db_replica, "Реплицируется в парный регион", $tags="task3")
Rel(fraud_db, db_replica, "Реплицируется в парный регион", $tags="task3")
Rel(notification_db, db_replica, "Реплицируется в парный регион", $tags="task3")
Rel(kafka, kafka_mirror, "Зеркалирует критичные топики и контрольные точки", $tags="task3")

Rel(prometheus, owner_registry, "Собирает состояние сегментов", $tags="task3")
Rel(prometheus, booking, "Собирает метрики")
Rel(prometheus, kafka, "Собирает метрики через экспортёры")
Rel(prometheus, flink, "Собирает метрики")
Rel(grafana, prometheus, "Запрашивает метрики")
Rel(prometheus, alertmanager, "Передаёт сработавшие правила")
Rel(booking, loki, "Журналы")
Rel(booking, otel, "Распределённые трассы")
Rel(otel, jaeger, "Передаёт трассы")
Rel(sre, grafana, "Контролирует состояние")
Rel(sre, alertmanager, "Получает оповещения")

note right of lb #FDECEC
  Красным выделены изменения задания 3.
  Для новой операции выбирается ближайший здоровый регион.
  Существующая сущность обслуживается текущим владельцем
  её домашнего сегмента.
end note

note right of owner_registry #FDECEC
  Реестр хранит только служебное состояние владения.
  При аварии active_region меняется только после
  повышения резервных баз и проверки готовности.
end note

SHOW_LEGEND()
@enduml