@startuml GoFuture_C2_ToBe_Task1
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_LEFT_RIGHT()

title GoFuture — целевая архитектура периода поэтапной декомпозиции

Person(passenger, "Пассажир", "Заказывает и оплачивает поездки")
Person(driver, "Водитель", "Принимает поездки и передаёт местоположение")
Person(manager, "Корпоративный менеджер", "Управляет корпоративными поездками")
Person(accountant, "Бухгалтер", "Контролирует платежи и выплаты")
Person(sre, "SRE-инженер", "Контролирует надёжность и инциденты")

System_Boundary(gofuture, "GoFuture") {
    Container(passenger_app, "Пассажирское приложение", "iOS / Android / Huawei", "Клиентское приложение пассажира")
    Container(driver_app, "Водительское приложение", "iOS / Android / Huawei", "Клиентское приложение водителя")
    Container(corp_portal, "Корпоративный портал", "React/Vue.js", "Интерфейс корпоративных клиентов")
    Container(admin_portal, "Административная панель", "Django Admin", "Операционный интерфейс")

    Container(api_gateway, "Шлюз программного интерфейса", "HTTP/REST", "Единая входная точка, маршрутизация и переключение между монолитом и сервисами")

    Boundary(target_domains, "Целевые доменные сервисы") {
        Container(booking, "Booking — сервис бронирования", "Django/Python", "Жизненный цикл поездки; принимает решение о назначении выбранного водителя")
        Container(driver_service, "Driver — сервис водителей", "Django/Python", "Профиль, рабочее состояние и решение о том, может ли водитель принимать заказы")
        Container(pricing, "Pricing — сервис ценообразования", "Django/Python", "Тарифы и динамический расчёт цены")
        Container(payments, "Payments — сервис платежей", "Django/Python", "Платежи пассажиров, возвраты и выплаты водителям")
        Container(notification, "Notification — сервис уведомлений", "Django/Python + Celery", "Подготовка и доставка уведомлений")
        Container(geography, "Geography — сервис географии", "Django/Python", "Геопоиск, маршруты, зоны; находит и ранжирует подходящих водителей")
        Container(analytics, "Analytics — сервис аналитики", "Python", "Приём и подготовка аналитических данных")
        Container(fraud, "Fraud — сервис защиты от мошенничества", "Django/Python", "Оценка риска поездок и платёжных операций")

        ContainerDb(booking_db, "Booking PostgreSQL", "PostgreSQL", "Заказы, поездки и их состояния")
        ContainerDb(driver_db, "Driver PostgreSQL", "PostgreSQL", "Водители и их рабочее состояние")
        ContainerDb(pricing_db, "Pricing PostgreSQL", "PostgreSQL", "Тарифы, правила и коэффициенты")
        ContainerDb(payments_db, "Payments PostgreSQL", "PostgreSQL", "Платежи, возвраты и выплаты")
        ContainerDb(notification_db, "Notification PostgreSQL", "PostgreSQL", "Шаблоны, устройства и статусы доставки")
        ContainerDb(geography_db, "Geography PostgreSQL", "PostgreSQL", "Зоны и справочные геоданные")
        ContainerDb(fraud_db, "Fraud PostgreSQL", "PostgreSQL", "Правила, признаки и оценки риска")
        ContainerDb(analytics_db, "Аналитическое хранилище", "ClickHouse", "Факты и агрегаты")

        ContainerDb(driver_cache, "Оперативное хранилище Driver", "Redis", "Только состояние и кэш домена Driver")
        ContainerDb(pricing_cache, "Оперативное хранилище Pricing", "Redis", "Только кэш правил и коэффициентов Pricing")
        ContainerDb(geography_cache, "Оперативное хранилище Geography", "Redis", "Только краткоживущее географическое состояние")
        Container(search, "Геопоисковый индекс Geography", "Elasticsearch", "Поиск водителей и географических объектов")
    }

    Boundary(transition, "Переходный контур — временные компоненты") {
        Container(acl, "Слой обратной совместимости (ACL)", "Django/Python", "Адаптирует старые контракты и модель монолита к контрактам доменных сервисов")
        Container(monolith, "Монолит переходного периода", "Django/Python", "Оставшаяся бизнес-логика, которая ещё не перенесена")
        ContainerDb(monolith_db, "Унаследованная база", "PostgreSQL RDS", "Данные доменов, которые ещё не мигрировали")
        ContainerQueue(rabbitmq, "Брокер сообщений переходного периода", "RabbitMQ", "Асинхронные задачи до внедрения целевой событийной платформы")
    }

    Boundary(observability, "Наблюдаемость") {
        Container(prometheus, "Prometheus", "Система мониторинга", "Самостоятельно опрашивает конечные точки метрик")
        Container(grafana, "Grafana", "Средство визуализации", "Запрашивает метрики Prometheus и строит панели")
        Container(loki, "Loki", "Хранилище журналов", "Централизованный сбор журналов")
        Container(alertmanager, "Alertmanager", "Система оповещений", "Маршрутизация оповещений")
    }

    Container(jenkins, "Jenkins", "CI/CD", "Независимые сборки и развёртывания сервисов")
    Container(registry, "Docker Registry", "Хранилище образов", "Версионированные образы сервисов")
}

System_Ext(payment_gateways, "Платёжные шлюзы", "Яндекс Пэй и региональные поставщики")
System_Ext(bank_api, "Банковские программные интерфейсы", "Выплаты водителям")
System_Ext(maps, "Картографические сервисы", "Яндекс Карты и региональные поставщики")
System_Ext(push_providers, "Поставщики мобильных уведомлений", "FCM / APNS / Huawei Push Kit")

Rel(passenger, passenger_app, "Использует")
Rel(driver, driver_app, "Использует")
Rel(manager, corp_portal, "Использует")
Rel(accountant, admin_portal, "Использует")
Rel(sre, grafana, "Контролирует состояние")
Rel(sre, alertmanager, "Получает оповещения")

Rel(passenger_app, api_gateway, "Запросы", "HTTPS/REST")
Rel(driver_app, api_gateway, "Запросы", "HTTPS/REST")
Rel(corp_portal, api_gateway, "Запросы", "HTTPS/REST")
Rel(admin_portal, api_gateway, "Запросы", "HTTPS/REST")

Rel(api_gateway, acl, "Старые версии контрактов и маршрутизация переходного периода", "HTTP/REST")
Rel(api_gateway, booking, "Новые контракты Booking", "HTTP/REST")
Rel(api_gateway, driver_service, "Новые контракты Driver", "HTTP/REST")
Rel(api_gateway, pricing, "Новые контракты Pricing", "HTTP/REST")
Rel(api_gateway, payments, "Новые контракты Payments", "HTTP/REST")
Rel(api_gateway, notification, "Новые контракты Notification", "HTTP/REST")
Rel(api_gateway, geography, "Новые контракты Geography", "HTTP/REST")
Rel(api_gateway, fraud, "Новые контракты Fraud", "HTTP/REST")

Rel(acl, monolith, "Направляет ещё не перенесённые операции и позволяет откатить маршрут", "HTTP/REST")
Rel(acl, booking, "Адаптирует старый контракт Booking", "HTTP/REST")
Rel(acl, driver_service, "Адаптирует старый контракт Driver", "HTTP/REST")
Rel(acl, pricing, "Адаптирует старый контракт Pricing", "HTTP/REST")
Rel(acl, payments, "Адаптирует старый контракт Payments", "HTTP/REST")
Rel(acl, notification, "Адаптирует старый контракт Notification", "HTTP/REST")
Rel(acl, geography, "Адаптирует старый контракт Geography", "HTTP/REST")
Rel(acl, fraud, "Адаптирует старый контракт Fraud", "HTTP/REST")

Rel(monolith, monolith_db, "Читает и записывает только данные ещё не выделенных доменов", "SQL/ORM")

Rel(booking, booking_db, "Читает и записывает", "SQL/ORM")
Rel(driver_service, driver_db, "Читает и записывает", "SQL/ORM")
Rel(pricing, pricing_db, "Читает и записывает", "SQL/ORM")
Rel(payments, payments_db, "Читает и записывает", "SQL/ORM")
Rel(notification, notification_db, "Читает и записывает", "SQL/ORM")
Rel(geography, geography_db, "Читает и записывает", "SQL/ORM")
Rel(fraud, fraud_db, "Читает и записывает", "SQL/ORM")
Rel(analytics, analytics_db, "Записывает и читает аналитику", "SQL")

Rel(driver_service, driver_cache, "Хранит только состояние домена Driver")
Rel(pricing, pricing_cache, "Кэширует только правила и коэффициенты Pricing")
Rel(geography, geography_cache, "Хранит только краткоживущее состояние Geography")
Rel(geography, search, "Индексирует и ищет водителей")

Rel(booking, geography, "Запрашивает поиск и ранжирование подходящих водителей", "HTTP/REST")
Rel(booking, driver_service, "Проверяет доступность выбранного водителя", "HTTP/REST")
Rel(booking, pricing, "Запрашивает рассчитанную цену", "HTTP/REST")
Rel(booking, fraud, "Запрашивает оценку риска", "HTTP/REST")
Rel(booking, payments, "Инициирует финансовую операцию", "HTTP/REST")

Rel(booking, rabbitmq, "Переходные асинхронные задачи", "AMQP")
Rel(payments, rabbitmq, "Переходные асинхронные задачи", "AMQP")
Rel(notification, rabbitmq, "Получает задачи отправки", "AMQP")
Rel(analytics, rabbitmq, "Получает переходный поток данных", "AMQP")

Rel(geography, maps, "Получает маршруты и геоданные", "HTTPS")
Rel(payments, payment_gateways, "Выполняет платежи", "HTTPS")
Rel(payments, bank_api, "Выполняет выплаты", "HTTPS")
Rel(notification, push_providers, "Отправляет уведомления", "HTTPS")

Rel(prometheus, booking, "Собирает метрики", "HTTP")
Rel(prometheus, driver_service, "Собирает метрики", "HTTP")
Rel(prometheus, pricing, "Собирает метрики", "HTTP")
Rel(prometheus, payments, "Собирает метрики", "HTTP")
Rel(prometheus, notification, "Собирает метрики", "HTTP")
Rel(prometheus, geography, "Собирает метрики", "HTTP")
Rel(prometheus, analytics, "Собирает метрики", "HTTP")
Rel(prometheus, fraud, "Собирает метрики", "HTTP")
Rel(prometheus, monolith, "Собирает метрики переходного периода", "HTTP")
Rel(grafana, prometheus, "Запрашивает метрики", "PromQL")
Rel(prometheus, alertmanager, "Передаёт сработавшие правила")

Rel(booking, loki, "Журналы")
Rel(driver_service, loki, "Журналы")
Rel(pricing, loki, "Журналы")
Rel(payments, loki, "Журналы")
Rel(notification, loki, "Журналы")
Rel(geography, loki, "Журналы")
Rel(analytics, loki, "Журналы")
Rel(fraud, loki, "Журналы")
Rel(monolith, loki, "Журналы")

Rel(jenkins, registry, "Публикует образы", "Docker")
Rel(jenkins, booking, "Независимое развёртывание")
Rel(jenkins, driver_service, "Независимое развёртывание")
Rel(jenkins, pricing, "Независимое развёртывание")
Rel(jenkins, payments, "Независимое развёртывание")
Rel(jenkins, notification, "Независимое развёртывание")
Rel(jenkins, geography, "Независимое развёртывание")
Rel(jenkins, analytics, "Независимое развёртывание")
Rel(jenkins, fraud, "Независимое развёртывание")

note right of monolith
  Временный компонент переходного периода.
  Его область ответственности уменьшается
  после каждого этапа декомпозиции.
end note

note right of driver_cache
  Redis может физически размещаться
  в общем кластере, но области данных
  доменов изолированы. Междоменное
  чтение ключей запрещено.
end note

SHOW_LEGEND()
@enduml